# templates/default.conf.template
# Generic nginx proxy configuration with environment variable support
#
# Docker-aware: upstream hostnames are resolved at request time via the
# embedded Docker DNS (127.0.0.11). This lets nginx pick up new container
# IPs after a docker-compose service is recreated, without restarting the
# proxy. Tradeoff: we cannot use named upstream{} blocks (which would
# resolve once at config load and cache forever), so connection keepalive
# to backends is disabled. On a docker bridge network this is negligible.

resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

# Health check server
server {
    listen 80;
    server_name _;

    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

# Main Matrix server
server {
    listen 80;
    server_name ${MATRIX_DOMAIN};

    # Set maximum file upload size for Matrix media uploads
    client_max_body_size 50M;

    # Increase timeouts for large file uploads
    client_body_timeout 300s;
    client_header_timeout 60s;

    # Matrix server endpoints - well-known with RTC support
    location /.well-known/matrix/client {
        add_header Content-Type application/json;
        add_header Access-Control-Allow-Origin * always;
        return 200 '{
          "m.homeserver": {
            "base_url": "https://chat.dancemore.xyz/"
          },
          "org.matrix.msc2965.authentication": {
            "issuer": "https://auth.chat.dancemore.xyz/",
            "account": "https://auth.chat.dancemore.xyz/account/"
          },
          "element_call": {
            "use_exclusively": true,
            "participant_limit": 16
          },
          "org.matrix.msc4143.rtc_foci": [
            {
              "type": "livekit",
              "livekit_service_url": "https://livekit.chat.dancemore.xyz/livekit/jwt"
            }
          ]
        }';
    }

    location /.well-known/matrix/server {
        add_header Content-Type application/json;
        add_header Access-Control-Allow-Origin * always;
        return 200 '{"m.server": "chat.dancemore.xyz:443"}';
    }

    # MAS compatibility layer - these endpoints go to MAS, not Synapse
    location ~ ^/_matrix/client/(.*)/(login|logout|refresh) {
        set $upstream_auth ${MATRIX_AUTH_HOST}:${MATRIX_AUTH_PORT};
        proxy_pass http://$upstream_auth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_http_version 1.1;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # Matrix media upload endpoints - needs special handling for large files
    location /_matrix/media/ {
        set $upstream_synapse ${SYNAPSE_HOST}:${SYNAPSE_PORT};
        proxy_pass http://$upstream_synapse;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;

        # Extended timeouts for large file uploads
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;

        # Allow streaming uploads without buffering
        proxy_request_buffering off;
        proxy_buffering off;

        # Increase buffer sizes for large uploads
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Discord bridge avatar endpoint
    location /mautrix-discord/avatar/ {
        set $upstream_discord ${MAUTRIX_DISCORD_HOST}:${MAUTRIX_DISCORD_PORT};
        proxy_pass http://$upstream_discord;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;

        # Cache avatars for better performance
        proxy_cache_valid 200 1h;
        proxy_cache_valid 404 5m;

        # CORS headers for Discord access
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;

        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # All other Matrix endpoints go to Synapse
    location /_matrix/ {
        set $upstream_synapse ${SYNAPSE_HOST}:${SYNAPSE_PORT};
        proxy_pass http://$upstream_synapse;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;

        # WebSocket support for sync
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Increase timeouts for long-polling
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /_synapse/client {
        set $upstream_synapse ${SYNAPSE_HOST}:${SYNAPSE_PORT};
        proxy_pass http://$upstream_synapse;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # MAS-specific Synapse endpoints
    location /_synapse/mas/ {
        set $upstream_synapse ${SYNAPSE_HOST}:${SYNAPSE_PORT};
        proxy_pass http://$upstream_synapse;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # Element Web client (everything else)
    location / {
        set $upstream_element ${ELEMENT_WEB_HOST}:${ELEMENT_WEB_PORT};
        proxy_pass http://$upstream_element;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;

        # Handle large static files without buffering warnings
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}

# Matrix Authentication Service - Ready for cutover
server {
    listen 80;
    server_name ${AUTH_DOMAIN};

    location / {
        set $upstream_auth ${MATRIX_AUTH_HOST}:${MATRIX_AUTH_PORT};
        proxy_pass http://$upstream_auth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Increase timeouts for auth flows
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# Element Call
server {
    listen 80;
    server_name ${CALL_DOMAIN};

    location / {
        set $upstream_call ${ELEMENT_CALL_HOST}:${ELEMENT_CALL_PORT};
        proxy_pass http://$upstream_call;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
}

# LiveKit and MatrixRTC services
server {
    listen 80;
    server_name ${LIVEKIT_DOMAIN};

    # MatrixRTC Authorization Service - specific endpoints
    location /livekit/jwt/sfu/get {
        set $upstream_lkjwt ${LK_JWT_HOST}:${LK_JWT_PORT};
        proxy_pass http://$upstream_lkjwt/sfu/get;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;

        # Handle preflight
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With";
            return 204;
        }
    }

    location /livekit/jwt/healthz {
        set $upstream_lkjwt ${LK_JWT_HOST}:${LK_JWT_PORT};
        proxy_pass http://$upstream_lkjwt/healthz;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    # General JWT service fallback
    location /livekit/jwt/ {
        set $upstream_lkjwt ${LK_JWT_HOST}:${LK_JWT_PORT};
        proxy_pass http://$upstream_lkjwt/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;

        # CORS headers
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With";

        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }

    # LiveKit SFU WebSocket connection
    location /livekit/sfu/ {
        set $upstream_livekit ${LIVEKIT_HOST}:${LIVEKIT_PORT};
        proxy_pass http://$upstream_livekit/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;

        # WebSocket support for LiveKit
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # LiveKit specific settings
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # LiveKit server (everything else)
    location / {
        set $upstream_livekit ${LIVEKIT_HOST}:${LIVEKIT_PORT};
        proxy_pass http://$upstream_livekit;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_next_upstream error timeout http_502 http_503 http_504;

        # WebSocket support for LiveKit
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # LiveKit specific settings
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
